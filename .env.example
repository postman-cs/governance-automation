# API Governance Demo Configuration

# Postman Configuration (Required)
# Get your API key from: https://go.postman.co/settings/me/api-keys
POSTMAN_API_KEY=your-postman-api-key-here
# Find your workspace ID in the URL: https://[team].postman.co/workspace/{workspace-id}
WORKSPACE_ID=your-workspace-id-here

# Chat Integrations (Optional)
TEAMS_WEBHOOK_URL=your-teams-webhook-url-here
SLACK_WORKFLOW_URL=your-slack-workflow-url-here

# Static Website URLs
GOVERNANCE_STORAGE_ACCOUNT=yourstorageaccountname
GOVERNANCE_STORAGE_URL=https://yourstorageaccountname.z13.web.core.windows.net/

# Governance Configuration (Optional)
# Minimum score threshold for API quality gate (0-100)
# Default: 70, Pipeline options: 50, 60, 70, 80, 90
GOVERNANCE_THRESHOLD=70

# Governance mode: "specs" (default) or "apis"
# specs = Use Postman Spec Hub (recommended for most demos)
# apis = Use Postman APIs (advanced demos only)
GOVERNANCE_MODE=specs