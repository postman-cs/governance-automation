  },
  "keywords": [
    "api",
    "governance",
    "postman",
    "quality",
    "automation"
  ],
  "author": "Governance Team",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^17.2.2",
    "yargs": "^18.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
