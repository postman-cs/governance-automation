{
  "name": "governance-demo",
  "version": "1.0.0",
  "description": "API Governance Demo with Postman Integration",
  "main": "scripts/postman_governance-spec.js",
  "scripts": {
    "test": "node scripts/postman_governance-spec.js --help",
    "score": "node scripts/postman_governance-spec.js --workspace ${WORKSPACE_ID} --json",
    "notify": "node scripts/teams_notifier.js",
